# Copy to .env and adjust. .env is gitignored.

# PostgreSQL (used by docker-compose and the API)
POSTGRES_USER=ptp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ptp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ptp:change-me@localhost:5432/ptp

# Local data directory (Parquet files, see contract section 2.1)
PTP_DATA_DIR=./data

# API address used by the Streamlit frontend
PTP_API_URL=http://localhost:8000
